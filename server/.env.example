# Open Dialer token server — copy this file to .env and fill in YOUR values.
# Never commit .env to version control.

# From console.twilio.com — Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Create an API Key at console.twilio.com -> Account -> API keys & tokens
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# Your Twilio phone number that calls will come from (E.164 format)
TWILIO_CALLER_ID=+14155551234

# Create a TwiML App at console.twilio.com -> Voice -> TwiML Apps
# Set its "Call Status Changes" / voice REQUEST URL to your Twilio Function
# (see twiml-app/function-sample.js in this repo). Paste the AP... SID here.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the token server listens on (extension default: 3001)
PORT=3001
